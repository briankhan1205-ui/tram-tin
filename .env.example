# Postgres (ops/setup-db.sh tự sinh .env với mật khẩu ngẫu nhiên)
DATABASE_URL=postgresql://tram_tin:CHANGE_ME@localhost:5432/tram_tin

# Telegram: tạo bot qua @BotFather, lấy chat id bằng `make telegram-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bỏ thông báo cũ hơn N giờ (tránh dội bom khi bot lâu ngày không gửi được)
NOTIFY_MAX_AGE_HOURS=24
# Cảnh báo Telegram khi một nguồn lỗi liên tiếp N lần
ALERT_AFTER_FAILURES=3

# Crawler
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT="Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) TramTin/0.1 (personal RSS reader)"

# Web (bỏ trống = không bật Basic auth)
WEB_PORT=3100
WEB_HOST=127.0.0.1
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASSWORD=
# Link "Mở bảng tin" cuối mỗi tin Telegram (để trống thì bỏ)
WEB_PUBLIC_URL=http://127.0.0.1:3100
# Múi giờ hiển thị trên web
APP_TIMEZONE=Asia/Ho_Chi_Minh
